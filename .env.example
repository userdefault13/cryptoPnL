# Names only. Real values live in abra project `cryptoPnL`; run via: abra run cryptoPnL -- <cmd>
BASE_RPC_URL=https://base.drpc.org
ENVIO_API_TOKEN=
# Not yet provisioned:
# AarcadeGh$t subgraph Bearer key (currently stored in abra project `general` as SUBGRAPH_API_KEY):
SUBGRAPH_API_KEY=
# ETHERSCAN_API_KEY=   (deferred, no paid plan)
# HyperSync host budget (P3): flock path shared by every process on this host; budget per 60 s
HYPERSYNC_LOCK_PATH=~/.cache/cryptopnl/hypersync.lock
HYPERSYNC_RPM=5
# P3 pricing (all free, no keys). Optional overrides only:
# DEFILLAMA_URL=https://coins.llama.fi
# DEFILLAMA_SEARCH_WIDTH=3600
# DEX_MIN_QUOTE_USD=1000
# API_RPS=1
# CoinGecko is NOT used (free tier now needs a key; none provisioned). COINGECKO_API_KEY= would be the name if added later.
# Free public Base RPC host budget (P3): starts per sliding 60 s, min gap between starts, shared lock path
RPC_RPM=30
RPC_MIN_GAP_S=1.5
RPC_LOCK_PATH=~/.cache/cryptopnl/rpc.lock
# Ledger Postgres (omarchywin 127.0.0.1:5442) password for scripts/with_ledger_pg.sh, abra only (no fallback); user_default adds it.
CRYPTOPNL_LEDGER_PG_PASSWORD=
